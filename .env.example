# ---------------------------------------------------------------------------
# Pathwise environment. Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Core ---
PATHWISE_ENV=development           # development | test | production
PATHWISE_DEBUG=true
PATHWISE_LOG_LEVEL=INFO
PATHWISE_API_PORT=8000
PATHWISE_CORS_ORIGINS=http://localhost:5173

# --- Database (host-side default; docker-compose overrides host to `postgres`) ---
PATHWISE_DATABASE_URL=postgresql+asyncpg://pathwise:pathwise@localhost:5432/pathwise
POSTGRES_USER=pathwise
POSTGRES_PASSWORD=pathwise
POSTGRES_DB=pathwise

# --- Redis (cache + arq queue) ---
PATHWISE_REDIS_URL=redis://localhost:6379/0

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
PATHWISE_JWT_SECRET=change-me-in-production
PATHWISE_ACCESS_TOKEN_TTL_MINUTES=15
PATHWISE_REFRESH_TOKEN_TTL_DAYS=30

# --- LLM provider ---
PATHWISE_LLM_PROVIDER=anthropic     # anthropic | openai | fake
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PATHWISE_LLM_MODEL=claude-opus-5
PATHWISE_LLM_FAST_MODEL=claude-haiku-4-5
PATHWISE_LLM_MAX_TOKENS=16000
PATHWISE_LLM_TIMEOUT_SECONDS=120
PATHWISE_LLM_MAX_RETRIES=2
PATHWISE_LLM_CACHE_ENABLED=true

# --- Embeddings (fastembed / ONNX, no API key required) ---
PATHWISE_EMBEDDING_PROVIDER=fastembed   # fastembed | openai | fake
PATHWISE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
PATHWISE_EMBEDDING_DIM=384
